GITHUB_OWNER=outlain
IMAGE_TAG=latest
HELPER_UID=10001
HELPER_GID=10001

POLL_SECONDS=5
SETTLE_SECONDS=30
MAX_SCAN_WORKERS=1
DISCOVERY_WORKERS=4
DISCOVERY_QUEUE=64
MAX_DEFINITION_AGE_SECONDS=172800
CLAMD_CONNECT_TIMEOUT_SECONDS=5
SCAN_TIMEOUT_SECONDS=7200
MAX_STREAM_MIB=2000
INCOMPLETE_SUFFIXES=.part,.tmp,.crdownload,.aria2,.partial,.download,.!qb

# Optional marker names relative to each mounted root. Leave empty when unused.
WATCH_MOUNT_MARKER=
DEST_MOUNT_MARKER=
QUARANTINE_MOUNT_MARKER=
